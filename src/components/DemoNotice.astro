---
// The bar that marks this page as a demo. Everything on it is placeholder
// content, and a visitor deserves to be told that before they read a line of
// it.
//
// Switch it off with `demoNotice: false` in src/site.config.js once the
// content is yours — or delete this component and its two references.
const { repo } = Astro.props;
---

<div class="demo-notice">
  <p>
    <strong>Demo — placeholder content.</strong> Every name, paper, link and
    date below is invented. This page is the live preview of <a href={repo}
      >academic-homepage</a
    >, an open-source template for academic homepages.
  </p>
</div>

<style>
  .demo-notice {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-divider);
  }
  .demo-notice p {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 10px var(--gutter);
    font-size: 14.5px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-text) 75%, transparent);
  }
</style>
